<Window x:Class="PSXperia.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PSXperia Remastered" Height="760" Width="1200" MinHeight="650" MinWidth="1000" WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Image x:Name="WaveBackground" Grid.ColumnSpan="2" Source="/PSXperia.App;component/Assets/playstation-wave.png" Stretch="UniformToFill" Opacity="0.34" IsHitTestVisible="False"><Image.RenderTransform><TransformGroup><ScaleTransform ScaleX="1.10" ScaleY="1.10"/><TranslateTransform X="-18" Y="0"/></TransformGroup></Image.RenderTransform></Image><Border Grid.ColumnSpan="2" Background="#7512101A" IsHitTestVisible="False"/>
<Ellipse x:Name="BubbleGlow" Grid.Column="1" Width="330" Height="330" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,36,0" Opacity="0.22" IsHitTestVisible="False"><Ellipse.RenderTransform><TranslateTransform X="0" Y="0"/></Ellipse.RenderTransform><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#D8A5FF" Offset="0"/><GradientStop Color="#8A7549D6" Offset="0.48"/><GradientStop Color="#007549D6" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
<Ellipse Grid.Column="1" Width="150" Height="150" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,280,210,0" Opacity="0.08" IsHitTestVisible="False"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#F0B8FF" Offset="0"/><GradientStop Color="#008B5DD5" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
<Border Background="#E8171321" Padding="20"><DockPanel>
<StackPanel DockPanel.Dock="Top">
<StackPanel Orientation="Horizontal" Margin="0,8,0,36"><Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource PocketGradient}"><TextBlock Text="◈" Foreground="#FFFFFF" FontSize="27" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="11,1,0,0" VerticalAlignment="Center"><TextBlock Text="PSXPERIA" Foreground="{StaticResource FgBrush}" FontSize="17" FontWeight="Bold"/><TextBlock Text="PLAYSTATION POCKET EDITION" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel></StackPanel>
<TextBlock Text="WORKSPACE" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="4,0,0,12"/>
<Button x:Name="DashboardNav" Content="▦   Dashboard" HorizontalContentAlignment="Left" Margin="0,0,0,7" Click="DashboardNav_Click"/>
<Button x:Name="LibraryNav" Content="▤   Game Library" HorizontalContentAlignment="Left" Margin="0,0,0,7" Background="Transparent" Click="LibraryNav_Click"/>
<Button x:Name="ConverterNav" Content="⇄   Converter" HorizontalContentAlignment="Left" Margin="0,0,0,7" Background="Transparent" Click="OpenConverter_Click"/>
<Button x:Name="CompatibilityNav" Content="▣   Compatibility" HorizontalContentAlignment="Left" Margin="0,0,0,7" Background="Transparent" Click="CompatibilityNav_Click"/>
<TextBlock Text="TOOLS" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="4,25,0,12"/>
<Button x:Name="DeviceNav" Content="▱   Xperia Device" HorizontalContentAlignment="Left" Margin="0,0,0,7" Background="Transparent" Click="DeviceNav_Click"/>
<Button x:Name="SettingsNav" Content="⚙   Settings" HorizontalContentAlignment="Left" Margin="0,0,0,7" Background="Transparent" Click="SettingsNav_Click"/>
</StackPanel>
<Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="12"><StackPanel><TextBlock Text="TARGET DEVICE" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold"/><TextBlock Text="Xperia Play R800i" Foreground="{StaticResource FgBrush}" FontWeight="SemiBold" Margin="0,6,0,2"/><TextBlock Text="Not connected" Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel></Border>
</DockPanel></Border>
<Grid Grid.Column="1"><ScrollViewer x:Name="DashboardView"><StackPanel Margin="34,28,34,34">
<DockPanel Margin="0,0,0,28"><Border DockPanel.Dock="Right" Background="#38234A" CornerRadius="14" Padding="12,7" VerticalAlignment="Center"><TextBlock Text="● FOUNDATION BUILD" Foreground="#E6B7E0" FontSize="10" FontWeight="Bold"/></Border><StackPanel><TextBlock Text="Dashboard" Foreground="{StaticResource FgBrush}" FontSize="28" FontWeight="Bold"/><TextBlock Text="Your PlayStation conversion workspace." Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,5,0,0"/></StackPanel></DockPanel>
<Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="18"><StackPanel><TextBlock Text="GAMES IN LIBRARY" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="LibraryCount" Text="0" Foreground="{StaticResource FgBrush}" FontSize="30" FontWeight="Bold" Margin="0,7,0,0"/><TextBlock x:Name="LibrarySubtitle" Text="No games imported" Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel></Border>
<Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="18"><StackPanel><TextBlock Text="SUCCESSFULLY CONVERTED" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="ConvertedCount" Text="0" Foreground="{StaticResource FgBrush}" FontSize="30" FontWeight="Bold" Margin="0,7,0,0"/><TextBlock x:Name="ConvertedSubtitle" Text="No conversion jobs yet" Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel></Border>
<Border Grid.Column="4" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="18"><StackPanel><TextBlock Text="COMPATIBILITY TESTS" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="CompatibilityCount" Text="0" Foreground="{StaticResource FgBrush}" FontSize="30" FontWeight="Bold" Margin="0,7,0,0"/><TextBlock x:Name="CompatibilitySubtitle" Text="Awaiting device testing" Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel></Border></Grid>
<Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="22" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="READY FOR YOUR NEXT GAME?" Foreground="{StaticResource PinkBrush}" FontSize="10" FontWeight="Bold"/><TextBlock Text="Build your PS1 library." Foreground="{StaticResource FgBrush}" FontSize="22" FontWeight="Bold" Margin="0,8,0,5"/><TextBlock Text="Import BIN, CUE, or supported disc images. We'll validate files before conversion." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" MaxWidth="600"/></StackPanel><Button Grid.Column="1" Content="＋  Add Game Images" Background="{StaticResource PocketGradient}" Foreground="#FFFFFF" VerticalAlignment="Center" Padding="18,13" Click="AddGames_Click"/></Grid></Border>
<TextBlock Text="Recent activity" Foreground="{StaticResource FgBrush}" FontSize="17" FontWeight="Bold" Margin="0,8,0,12"/>
<Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="20">
<StackPanel>
<StackPanel x:Name="EmptyLibraryPanel" HorizontalAlignment="Center" Margin="0,24">
<TextBlock Text="◷" FontSize="30" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
<TextBlock Text="Your library is empty" Foreground="{StaticResource FgBrush}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,9,0,4"/>
<TextBlock Text="Import a CUE sheet or supported disc image to get started." Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Center"/>
</StackPanel>
<DockPanel>
<StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
<Button Content="＋  Set 170 × 170 Cover Art" Click="SetCover_Click" Padding="12,8"/>
</StackPanel>
<ListView x:Name="GamesList" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Foreground="{StaticResource FgBrush}" MaxHeight="360">
<ListView.ItemTemplate><DataTemplate><Grid Margin="4,7"><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
<Border Width="48" Height="48" CornerRadius="5" Background="{StaticResource Panel2Brush}" ClipToBounds="True">
<Image Source="{Binding CoverPath}" Stretch="UniformToFill"/>
</Border>
<StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,8,0">
<TextBlock Text="{Binding Title}" Foreground="{StaticResource FgBrush}" FontWeight="SemiBold" FontSize="13"/>
<TextBlock Text="{Binding ImagePath}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/>
<TextBlock Foreground="{StaticResource MutedBrush}" FontSize="10">
<Run Text="{Binding Region, TargetNullValue='Region unknown'}"/><Run Text="  •  "/><Run Text="{Binding TrackCount}"/><Run Text=" tracks  •  "/><Run Text="{Binding DataTrackCount}"/><Run Text=" data / "/><Run Text="{Binding AudioTrackCount}"/><Run Text=" audio"/>
</TextBlock>
<TextBlock Text="{Binding DiscSerial, TargetNullValue='Serial not found'}" Foreground="{StaticResource PinkBrush}" FontSize="10"/>

</StackPanel>
<Border Grid.Column="2" Background="#302642" CornerRadius="8" Padding="9,5" VerticalAlignment="Center" Margin="0,0,8,0"><TextBlock Text="{Binding Compatibility}" Foreground="{StaticResource PinkBrush}" FontSize="10"/></Border>
<Button Grid.Column="3" Content="−" Tag="{Binding Id}" Click="RemoveGame_Click" Width="28" Height="28" Padding="0" FontSize="18" FontWeight="Bold" Foreground="#F2A6B5" Background="#3A202D" BorderBrush="#704052" BorderThickness="1" ToolTip="Remove this game from your library" VerticalAlignment="Center"/>
</Grid></DataTemplate></ListView.ItemTemplate>
</ListView>
</DockPanel>
</StackPanel>
</Border>
<TextBlock Text="Private development build • Image inspection and library import enabled" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,20,0,0"/>
</StackPanel></ScrollViewer><ContentControl x:Name="WorkspaceHost" Visibility="Collapsed"/></Grid></Grid></Window>

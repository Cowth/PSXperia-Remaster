<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup>
<OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF>
<Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><PlatformTarget>x64</PlatformTarget><Platforms>x64</Platforms>
<AssemblyName>PSXperia.Remastered</AssemblyName><RootNamespace>PSXperia.App</RootNamespace>
</PropertyGroup>
<ItemGroup>
<ProjectReference Include="..\PSXperia.Engine\PSXperia.Engine.csproj"/>
<ProjectReference Include="..\PSXperia.Library\PSXperia.Library.csproj"/>
<ProjectReference Include="..\PSXperia.Device\PSXperia.Device.csproj"/>
  <Content Include="..\..\tools\PSXperiaTool.jar" Link="tools\PSXperiaTool.jar" CopyToOutputDirectory="PreserveNewest" />
  <Content Include="..\..\tools\LICENSE-PSXperiaTool.txt" Link="tools\LICENSE-PSXperiaTool.txt" CopyToOutputDirectory="PreserveNewest" />
  <Resource Include="Assets\playstation-wave.png" />
  <Content Include="Assets\background-music.mp3" Condition="Exists('Assets\background-music.mp3')" CopyToOutputDirectory="PreserveNewest" />
</ItemGroup>
</Project>
